{
    "database": {
        "host": "localhost",
        "user": "root",
        "password": "",
        "port": 3306,
        "charset": "utf8mb4",
        "autocommit": true,
        "pool_size": 5,
        "pool_name": "notebox_pool"
    },
    "application": {
        "name": "NoteBox - Sistema de Gestión de Inventario",
        "version": "1.0.0",
        "company_name": "Mi Empresa",
        "backup_interval_days": 7,
        "max_login_attempts": 3,
        "session_timeout_minutes": 30
    },
    "paths": {
        "backups": "exports/backups/",
        "reports": "exports/reports/",
        "logs": "exports/logs/",
        "temp": "temp/"
    },
    "ui": {
        "theme": "default",
        "language": "es",
        "date_format": "%d/%m/%Y",
        "decimal_places": 2
    }
}